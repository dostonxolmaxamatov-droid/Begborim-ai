# Copy to .env, replace placeholders. Never commit .env.
# SHIRIN_TOKEN is the app connection code; generate your own random value.
SHIRIN_TOKEN=
# Credentials from your own Higgsfield API account; leave blank for local-only tools.
HF_KEY=
# Example: https://shirin.your-domain.example (your actual HTTPS server address)
PUBLIC_BASE_URL=
SHIRIN_WORKERS=2
SHIRIN_MAX_UPLOAD_MB=256
